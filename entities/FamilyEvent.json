{
  "name": "FamilyEvent",
  "type": "object",
  "properties": {
    "title": { "type": "string", "description": "Titolo dell'impegno" },
    "description": { "type": "string", "description": "Descrizione" },
    "date": { "type": "string", "format": "date", "description": "Data" },
    "time": { "type": "string", "description": "Orario" },
    "category": {
      "type": "string",
      "enum": ["scuola", "sport", "medico", "lavoro", "famiglia", "altro"],
      "description": "Categoria"
    },
    "assigned_to": { "type": "string", "description": "Assegnato a" },
    "completed": { "type": "boolean", "default": false, "description": "Completato" }
  },
  "required": ["title", "date"]
}
